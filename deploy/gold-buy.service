[Unit]
Description=Aurum Gold_Buy LangChain Analyzer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/gold-buy
EnvironmentFile=/opt/gold-buy/.env
ExecStart=/opt/gold-buy/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 80 --workers 1
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
