# Aurum environment template.
# Fill in real keys + recipients on the server. /opt/gold-buy/.env is loaded by
# systemd via EnvironmentFile=. Restart with `systemctl restart gold-buy`.

# ---- LLM (Aliyun DashScope OpenAI compatible mode) -----------------
# MODEL_NAME is the single source of truth: FastAPI (config.py), the deploy
# script's INJ_MODEL fallback, and the generated Hermes config.yaml all read
# from this value. Change it here and restart the service to switch models.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.6-plus
REQUEST_TIMEOUT=30
NEWS_LIMIT=3
PROMPT_VERSION=v5
MODEL_MAX_RETRIES=1
MOCK_LLM=0

# ---- Scheduler ----------------------------------------------------
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_SECONDS=1800
SCHEDULER_DAILY_ENABLED=1

# ---- Broadcast ----------------------------------------------------
WEBHOOK_URLS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEISHU_WEBHOOK_URL=
WECOM_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# ---- Hermes optional (only used if Hermes installed) --------------
OPENROUTER_API_KEY=

# ---- Admin --------------------------------------------------------
ADMIN_TOKEN=
ALLOW_TEST_NOTIFY=0
